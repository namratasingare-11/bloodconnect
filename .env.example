# ==========================================================
# BloodConnect Environment Configuration
# Copy to .env for local development (never commit secrets)
# ==========================================================

# Server Runtime
NODE_ENV=development
PORT=3000
APP_URL="http://localhost:3000"

# MySQL 8.0 Database Configuration
# Option A: Individual parameters
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bloodconnect_db
DB_SSL=false
DB_POOL_LIMIT=10
DB_CONNECT_TIMEOUT_MS=8000

# Option B: Full MySQL Connection URI (overrides individual DB_* values when set)
# DATABASE_URL="mysql://user:password@host:3306/bloodconnect_db?ssl-mode=REQUIRED"

# Authentication, Session & Brute-Force Protection
SESSION_TTL_HOURS=24
REMEMBER_ME_TTL_DAYS=14
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_WINDOW_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24

# Optional Outbound Email (SMTP) for Verification & Password Reset Emails
# Leave unset in local development to use the secure development preview token flow
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="BloodConnect Security <security@bloodconnect.org>"

# Google Maps Platform (Maps JavaScript API & Routes API)
# Leave empty to use the built-in interactive Swiss regional fallback radar map
VITE_GOOGLE_MAPS_API_KEY=

# Server-Side Gemini AI API Key (kept strictly on the server; never prefixed with VITE_)
GEMINI_API_KEY=

